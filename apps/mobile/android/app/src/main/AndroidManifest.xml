<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Photo/video picking for media import (Camera plugin's pickImages). Android 13+ (API 33) uses
         the granular media permissions; older versions fall back to READ_EXTERNAL_STORAGE. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- Voiceover recording (VoiceoverRecorder.tsx's plain `navigator.mediaDevices.getUserMedia({audio:
         true})` — no dedicated Capacitor microphone plugin here, just the raw Web API running inside
         the WebView). Without this declared, Capacitor's Bridge can never grant the WebView's own
         `onPermissionRequest` for RESOURCE_AUDIO_CAPTURE — a runtime permission can only be requested
         (and so only ever succeed) for a permission the manifest actually lists, so getUserMedia's
         permission prompt failed outright rather than merely being denied by the user. This was the
         actual reported bug: recording on Android always failed with "no permission" — not fixable from
         the OS Settings app either, since a permission the manifest never declares has nothing there to
         toggle on. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
</manifest>
