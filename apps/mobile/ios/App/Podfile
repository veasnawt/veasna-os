require_relative '../../../../node_modules/.pnpm/@capacitor+ios@7.6.8_@capacitor+core@7.6.8/node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '14.0'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../../../node_modules/.pnpm/@capacitor+ios@7.6.8_@capacitor+core@7.6.8/node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../../../node_modules/.pnpm/@capacitor+ios@7.6.8_@capacitor+core@7.6.8/node_modules/@capacitor/ios'
  pod 'CapacitorFilesystem', :path => '../../../../node_modules/.pnpm/@capacitor+filesystem@7.1.8_@capacitor+core@7.6.8/node_modules/@capacitor/filesystem'
  pod 'CapacitorShare', :path => '../../../../node_modules/.pnpm/@capacitor+share@7.0.4_@capacitor+core@7.6.8/node_modules/@capacitor/share'
end

target 'App' do
  capacitor_pods
  # LGPL-3.0 "full" package, not "full-gpl": no libx264/libfdk-aac, so this carries none of
  # GPLv3's linking obligations for App Store/TestFlight distribution. H.264/H.265 export uses
  # Apple's own VideoToolbox hardware encoders instead (confirmed present in the compiled binary,
  # not just assumed from the package name) — see FFmpegKitLGPL/ffmpeg-kit-lgpl.podspec for where
  # the binaries actually come from (the official ffmpeg-kit project retired in 2025).
  pod 'ffmpeg-kit-lgpl', :path => 'FFmpegKitLGPL'
end

post_install do |installer|
  assertDeploymentTarget(installer)
end
