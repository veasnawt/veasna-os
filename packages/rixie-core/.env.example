# Rixie Core Environment Configuration (Provider-Agnostic)

# Select Provider: anthropic | openai | gemini | ollama | openrouter
RIXIE_PROVIDER=anthropic

# API Keys (Provide the key matching your chosen provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Custom API Base URL (for Ollama, OpenRouter, Groq, DeepSeek, Local LLMs)
# OPENAI_BASE_URL=http://localhost:11434/v1

# Optional: Model Choice (Default: auto-selected by provider)
# RIXIE_MODEL=claude-3-5-sonnet-latest  # Anthropic
# RIXIE_MODEL=gpt-4o                   # OpenAI
# RIXIE_MODEL=gemini-2.0-flash         # Gemini
# RIXIE_MODEL=llama3.1                 # Ollama

RIXIE_MAX_TOKENS=2048
RIXIE_MEMORY_DB=./core/data/memory.db
