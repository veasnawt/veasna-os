# Rixie Agent Configuration for BP Studio
# Copy this file to .env.local (gitignored) and fill in your own values — never commit .env.local.

RIXIE_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
RIXIE_MODEL=claude-sonnet-5

# Optional:
# OPENAI_API_KEY=your_openai_key
# GEMINI_API_KEY=your_gemini_key
# OPENAI_BASE_URL=http://localhost:11434/v1
RIXIE_MAX_TOKENS=2048
# Absolute path required: Next.js runs with this studio's directory as cwd, so a relative
# path here would create a disconnected empty DB instead of sharing Rixie's real memory vault.
RIXIE_MEMORY_DB=/absolute/path/to/your/memory.db
